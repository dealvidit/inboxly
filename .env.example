# ─────────────────────────────────────────────────────────────────────────────
# Inboxly environment
#
# Copy to .env and fill in. Every variable here is validated by src/lib/env.ts at
# startup; a missing or malformed value fails the boot with a message naming it.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of this deployment. Used to build absolute URLs.
APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is the pooled endpoint used by the application.
# DIRECT_DATABASE_URL is the direct (unpooled) endpoint used by migrations.
# Locally they are the same; on serverless they must differ. See ADR 0009.
DATABASE_URL=postgresql://inboxly:inboxly@localhost:5432/inboxly
DIRECT_DATABASE_URL=postgresql://inboxly:inboxly@localhost:5432/inboxly

# ─── Google OAuth / Gmail ────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Enable the Gmail API on the same project, and add the
# redirect URI below to the client's authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ─── Cryptography ────────────────────────────────────────────────────────────
# Encrypts OAuth refresh tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Rotating this key invalidates stored refresh tokens and forces users to reconnect.
ENCRYPTION_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Selects the AiProvider implementation: anthropic | gemini. See ADR 0005.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Set to false to skip AI calls during local development.
AI_ENABLED=true

# ─── Background jobs ─────────────────────────────────────────────────────────
# Authenticates the scheduler against /api/jobs/*. At least 24 characters:
#   openssl rand -hex 24
CRON_SECRET=

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Upper bound on messages pulled during a first-time backfill. See ADR 0004.
SYNC_MAX_BACKFILL_MESSAGES=500
# Wall-clock budget per sync invocation, with headroom before the platform timeout.
SYNC_TIME_BUDGET_MS=45000

# Emails analysed per runner invocation. See ADR 0006.
ANALYSIS_BATCH_SIZE=10
# Total lifecycle attempts before an email is marked FAILED.
ANALYSIS_MAX_ATTEMPTS=3
# Corrective retries within a single analysis attempt. See ADR 0007.
ANALYSIS_MAX_CORRECTIONS=2
# How long a claimed email stays leased before another runner may reclaim it.
ANALYSIS_LEASE_MS=300000
# Wall-clock budget per analysis invocation.
ANALYSIS_TIME_BUDGET_MS=45000
